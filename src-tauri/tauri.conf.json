{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sshOs",
  "version": "0.1.0",
  "identifier": "app.sshos.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "npm run vendor && trunk serve --config frontend/Trunk.toml",
    "beforeBuildCommand": "npm run vendor && trunk build --release --config frontend/Trunk.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "sshOs",
        "fullscreen": false,
        "decorations": true,
        "maximized": true,
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "GPL-3.0-or-later"
  }
}
